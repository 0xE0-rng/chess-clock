    <CheckBoxPreference android:title="@string/pref_title_moves_counter" android:key="@string/pref_key_moves_counter" android:defaultValue="@bool/pref_default_moves_counter" />
    <CheckBoxPreference android:title="@string/pref_title_show_increment_elapsed" android:key="@string/pref_key_show_delay_elapsed" android:summary="@string/pref_summary_show_increment_elapsed" android:defaultValue="@bool/pref_default_show_increment_elapsed" />

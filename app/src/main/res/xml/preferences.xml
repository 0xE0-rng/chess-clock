    <CheckBoxPreference android:title="@string/pref_title_sfx" android:key="@string/pref_key_sfx" android:defaultValue="@bool/pref_default_sfx" />
    <CheckBoxPreference android:title="@string/pref_title_vibe" android:key="@string/pref_key_vibe" android:defaultValue="@bool/pref_default_vibe" />
